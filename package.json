{
  "name": "cryptofolio",
  "version": "1.2.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/export-messages.js && node scripts/check-i18n-coverage.js && next build --webpack",
    "start": "next start",
    "local": "node scripts/local.mjs",
    "local:build": "node scripts/local.mjs --build",
    "test:local": "node --test scripts/__tests__/local-start.test.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n-coverage.js",
    "i18n:export": "node scripts/export-messages.js",
    "test": "jest",
    "test:demo:http": "NEXT_PUBLIC_INVESTATLAS_DEPLOYMENT_MODE=public_demo node scripts/test-public-demo-http.mjs",
    "test:demo:chrome": "NEXT_PUBLIC_INVESTATLAS_DEPLOYMENT_MODE=public_demo INVESTATLAS_DEMO_BROWSER=true node scripts/test-public-demo-http.mjs",
    "test:rules": "npx --yes firebase-tools@15.24.0 emulators:exec --project demo-investatlas-rules --only firestore \"node scripts/test-firestore-rules.mjs\"",
    "test:rules:private": "npx --yes firebase-tools@15.24.0 emulators:exec --project demo-investatlas-private-rules --only firestore \"node scripts/test-private-firestore-rules.mjs\"",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "icons:check": "node scripts/generate-app-icons.mjs --check"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5",
    "sharp": "0.35.5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "^8.5.23",
    "@grpc/grpc-js": "^1.13.6",
    "source-map-js": "^1.2.2",
    "brace-expansion@^1.0.0": "1.1.21",
    "sharp": "$sharp",
    "glob@>=9 <14.0.2": "14.0.6",
    "minimatch@>=7 <11.0.1": "11.0.8"
  },
  "license": "Apache-2.0"
}
