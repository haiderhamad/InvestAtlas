# Local source-release candidate only. No credentials are included.
# Keep the same deployment mode at BUILD and RUNTIME. Do not deploy legacy mode.
NEXT_PUBLIC_INVESTATLAS_DEPLOYMENT_MODE=local_personal

# Private Cloud: use your own Firebase project and exact authorized Auth UID.
# Set mode above to private_cloud, then supply these in your private host.
# NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_BUCKET
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
# NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
# INVESTATLAS_PRIVATE_OWNER_UID=YOUR_AUTH_USER_UID

# Optional trusted-WLAN public Yahoo reads only; disabled by default.
# Exact RFC1918 IPv4 origin must match the explicit server bind address.
# INVESTATLAS_LOCAL_YAHOO_LAN_ORIGIN=http://192.168.1.50:3000

# Optional server-side vault features require independently generated private
# credentials and a reviewed configuration. Never put real values in this file.
# FIREBASE_SERVICE_ACCOUNT_JSON=YOUR_PRIVATE_SERVICE_ACCOUNT_JSON
# AI_PROVIDER_VAULT_ACTIVE_KEY_ID=primary
# AI_PROVIDER_VAULT_KEYS=YOUR_KEYRING_JSON_WITH_BASE64_32_BYTE_VALUES
# INVESTATLAS_PUBLIC_APP_ORIGIN=https://YOUR_PRIVATE_HOST
# Hosted Tiingo ingress stays disabled by default; key ownership is not a
# substitute for provider rights, quotas and platform-level abuse controls.

# Optional Compose port; use the same stable browser URL after choosing it.
# INVESTATLAS_PORT=3010
