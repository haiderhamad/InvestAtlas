# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/.next-local/
/.next-local-lock/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip
/output/
/scratch/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/firebase-debug.log*
/firestore-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# Portable bootstrap belongs in the source distribution.
!next-env.d.ts

# price history cache
/.cache/

# ai provider config (contains API keys)
/.config/

# runtime/state files (read/written by the app at runtime — never commit)
/.data-providers.json

# audit/temp artifacts and local Codex Flow task journals
/audit_results/
/.playwright-cli/
/.ai-bridge/

# generated i18n bundles (regenerated by scripts/export-messages.js on build)
/messages/

# user-owned private hosting rules/config - never include UID/project-specific files
/.private/

# editor workspace settings (personal)
/.vscode/
